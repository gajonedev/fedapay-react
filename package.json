{
  "name": "@gajonedev/fedapay-react",
  "version": "2.0.0",
  "description": "FedaPay CheckoutJS integration for React 18+ and Next.js",
  "author": "FedaPay",
  "license": "MIT",
  "repository": "https://github.com/gajonedev/fedapay-react",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/esm/index.d.ts"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16",
    "npm": ">=7"
  },
  "scripts": {
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "fedapay",
    "payment",
    "checkout",
    "react",
    "nextjs",
    "west-africa",
    "xof"
  ]
}
